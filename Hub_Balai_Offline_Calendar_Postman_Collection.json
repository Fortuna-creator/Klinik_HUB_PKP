            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/offline/balai/consultations/my-bookings?userId={{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "offline", "balai", "consultations", "my-bookings"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{user_id}}",
                  "description": "User ID"
                }
              ]
            },
            "description": "**Purpose:** User lihat riwayat booking mereka\n\n**Auth:** Required (Bearer Token)\n\n**Response:**\n- upcomingConsultations: Consultations yang akan datang\n- pastConsultations: Riwayat yang sudah lewat\n- statusSummary: Summary by status (pending, confirmed, completed, cancelled)\n\n**Use Case:** Halaman 'My Bookings' dengan 2 section: Upcoming & History\n\n**Note:** Paste JWT token di variable jwt_token sebelum test"
          },
          "response": [
            {
              "name": "Success - My Bookings",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/offline/balai/consultations/my-bookings?userId=1"
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"success\",\n  \"data\": {\n    \"userId\": 1,\n    \"userName\": \"John Doe\",\n    \"upcomingConsultations\": [\n      {\n        \"id\": \"b6c02e8e-22a9-4d50-babc-dc9baf2f1f2a\",\n        \"user\": {\n          \"id\": 1,\n          \"name\": \"John Doe\"\n        },\n        \"balai\": {\n          \"id\": \"7c5a3c5f-8a77-4d4e-9e0b-41b0b912c5a1\",\n          \"name\": \"Balai Pelatihan Konstruksi Jakarta\"\n        },\n        \"consultationDate\": \"2025-11-20\",\n        \"consultationTime\": \"09:00:00\",\n        \"status\": \"confirmed\",\n        \"createdAt\": \"2025-11-10T10:00:00Z\",\n        \"updatedAt\": \"2025-11-10T11:00:00Z\"\n      }\n    ],\n    \"pastConsultations\": [],\n    \"totalUpcoming\": 1,\n    \"totalPast\": 0,\n    \"statusSummary\": {\n      \"pending\": 0,\n      \"confirmed\": 1,\n      \"completed\": 0,\n      \"cancelled\": 0\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "Get Consultations by User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/offline/balai/consultations/user/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "offline", "balai", "consultations", "user", "{{user_id}}"]
            },
            "description": "**Purpose:** Get semua consultations user (simple list)\n\n**Auth:** Required\n\n**Response:** List of OfflineConsultationResponse\n\n**Difference from My Bookings:** Endpoint ini return simple list, sedangkan My Bookings return data yang sudah di-group (upcoming vs past) dengan summary"
          },
          "response": []
        }
      ]
    },
