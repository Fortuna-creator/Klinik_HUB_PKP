{
  "info": {
    "name": "Hub Balai Offline Calendar API",
    "description": "Postman collection untuk testing Balai Offline Calendar & Booking features. Includes endpoints untuk available slots, booked dates calendar, my bookings, daily schedule, dan consultation management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "hub-backend",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "Base URL for the API"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string",
      "description": "JWT access token for authentication (paste token here after login)"
    },
    {
      "key": "balai_id",
      "value": "7c5a3c5f-8a77-4d4e-9e0b-41b0b912c5a1",
      "type": "string",
      "description": "Sample Balai ID (replace with actual ID)"
    },
    {
      "key": "user_id",
      "value": "1",
      "type": "string",
      "description": "User ID for testing"
    },
    {
      "key": "consultation_id",
      "value": "",
      "type": "string",
      "description": "Consultation ID (will be auto-populated after create)"
    },
    {
      "key": "test_date",
      "value": "2025-11-20",
      "type": "string",
      "description": "Test date for booking (format: YYYY-MM-DD)"
    },
    {
      "key": "test_time",
      "value": "09:00:00",
      "type": "string",
      "description": "Test time for booking (format: HH:mm:ss)"
    }
