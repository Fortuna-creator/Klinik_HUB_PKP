    {
      "name": "4. Consultation CRUD",
      "description": "Create, Read, Update, Delete consultations (existing endpoints)",
      "item": [
        {
          "name": "Create Consultation (Book)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Auto-save consultation ID to variable",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.id) {",
                  "        pm.collectionVariables.set('consultation_id', jsonData.data.id);",
                  "        console.log('Consultation ID saved:', jsonData.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{user_id}},\n  \"balaiId\": \"{{balai_id}}\",\n  \"consultationDate\": \"{{test_date}}\",\n  \"consultationTime\": \"{{test_time}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/offline/balai/consultations",
              "host": ["{{base_url}}"],
              "path": ["api", "offline", "balai", "consultations"]
            },
            "description": "**Purpose:** User membuat booking konsultasi\n\n**Auth:** Required\n\n**Validations:**\n- Tanggal harus di masa depan\n- Waktu harus dalam jam kerja (08:00-17:00)\n- User tidak bisa book slot yang sama 2x\n\n**Note:** Consultation ID akan auto-saved ke variable setelah create"
          },
          "response": [
            {
              "name": "Success - Created",
              "originalRequest": {
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"userId\": 1,\n  \"balaiId\": \"7c5a3c5f-8a77-4d4e-9e0b-41b0b912c5a1\",\n  \"consultationDate\": \"2025-11-20\",\n  \"consultationTime\": \"09:00:00\"\n}"
                }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"success\",\n  \"message\": \"Consultation created successfully.\",\n  \"data\": {\n    \"id\": \"b6c02e8e-22a9-4d50-babc-dc9baf2f1f2a\",\n    \"user\": {\n      \"id\": 1,\n      \"name\": \"John Doe\"\n    },\n    \"balai\": {\n      \"id\": \"7c5a3c5f-8a77-4d4e-9e0b-41b0b912c5a1\",\n      \"name\": \"Balai Pelatihan Konstruksi Jakarta\"\n    },\n    \"consultationDate\": \"2025-11-20\",\n    \"consultationTime\": \"09:00:00\",\n    \"status\": \"pending\",\n    \"createdAt\": \"2025-11-12T10:00:00Z\",\n    \"updatedAt\": \"2025-11-12T10:00:00Z\"\n  }\n}"
            }
          ]
        },
