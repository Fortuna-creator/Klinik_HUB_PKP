          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "src": [],
                  "type": "file"
                },
                {
                  "key": "folder",
                  "value": "documents",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/files/upload",
