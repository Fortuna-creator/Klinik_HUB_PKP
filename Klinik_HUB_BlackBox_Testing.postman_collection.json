                "    pm.expect(json.success).to.be.true;",
                "    pm.expect(json.data).to.be.an('array');",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/consultations/me?status=all&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["consultations", "me"],
              "query": [
                { "key": "status", "value": "all" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
