            },
            "url": { "raw": "{{baseUrl}}/consultations/book", "host": ["{{baseUrl}}"], "path": ["consultations", "book"] }
          }
        },
        {
          "name": "B-07 Lihat booking sendiri",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"B-07: Status 200 OK + daftar booking\", function () {",
                "    pm.response.to.have.status(200);",
