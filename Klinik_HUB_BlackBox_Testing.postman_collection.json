            "body": {
              "mode": "raw",
              "raw": "{\n  \"balaiId\": \"{{testBalaiId}}\",\n  \"date\": \"2026-12-31\",\n  \"timeSlot\": \"09.00 - 10.00\",\n  \"topic\": \"Duplicate Key\",\n  \"description\": \"Same idempotency key\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/consultations/book", "host": ["{{baseUrl}}"], "path": ["consultations", "book"] }
          }
