            "url": { "raw": "{{baseUrl}}/consultations/{{testConsultationId}}/verify", "host": ["{{baseUrl}}"], "path": ["consultations", "{{testConsultationId}}", "verify"] }
          }
        },
        {
          "name": "B-09 Verifikasi kehadiran kode salah",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"B-09: Status 400 Bad Request\", function () {",
                "    pm.response.to.have.status(400);",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
